{
    "name": "eplfront",
    "version": "1.0.10",
    "license": "CECILL-2.1",
    "author": {
        "name": "DIP, Direction du numérique, Université de Strasbourg",
        "email": "dnum-dip@unistra.fr"
    },
    "description": "Web application to facilitate the deduplication of periodicals within a group of libraries",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "build:test": "vue-tsc --noEmit && vite build --mode deploy_test",
        "build:preprod": "vue-tsc --noEmit && vite build --mode deploy_preprod",
        "build:prod": "vue-tsc --noEmit && vite build --mode deploy_prod",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:unit:coverage": "vitest --coverage",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "lint:eslint": "eslint . --fix",
        "lint": "run-s lint:*",
        "format": "prettier --write src/",
        "format:silent": "prettier --log-level error --write src/",
        "prepare": "husky",
        "i18n-report": "pnpm dlx vue-i18n-extract report --vueFiles './?(src|constants)/**/*.?(ts|vue)' --languageFiles './src/locales/*.json'"
    },
    "dependencies": {
        "@quasar/extras": "^2.1.0",
        "@sentry/vue": "^11.4.0",
        "@zxcvbn-ts/core": "^4.2.0",
        "@zxcvbn-ts/language-common": "^4.1.3",
        "axios": "^1.20.0",
        "chart.js": "^4.5.1",
        "marked": "^18.1.0",
        "pinia": "^4.0.3",
        "quasar": "^2.34.0",
        "vue": "^3.5.43",
        "vue-chartjs": "^5.3.4",
        "vue-i18n": "^11.4.13",
        "vue-matomo": "^4.2.0",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.6.0",
        "@quasar/vite-plugin": "^2.0.2",
        "@tsconfig/node22": "^22.0.6",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.4",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.12.0",
        "eslint-plugin-oxlint": "^1.87.0",
        "eslint-plugin-vue": "~10.11.1",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.2",
        "npm-run-all2": "^9.0.3",
        "oxlint": "^1.87.0",
        "prettier": "3.9.9",
        "sass-embedded": "^1.105.1",
        "typescript": "~6.0.3",
        "vite": "^8.3.3",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.3",
        "vue-tsc": "3.3.11"
    }
}
